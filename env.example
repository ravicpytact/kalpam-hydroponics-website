# Copy to `.env.local` (dev) or Vercel Environment Variables (production).

# Public site URL — no trailing slash (used for canonicals, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://kalpam.vercel.app

# Optional — HTML meta verification (Search Console / Bing Webmaster Tools)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
