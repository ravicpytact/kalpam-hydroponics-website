# Copy to `.env.local` (dev) or Vercel Environment Variables (production).

# Public site URL — no trailing slash (used for canonicals, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://kalpam.vercel.app

# Contact form — SMTP (Gmail App Password; port 465 = SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Login credentials for the SMTP server (App Password account)
SMTP_USER=
SMTP_PASS=

# Sender — From address on outgoing enquiry emails (may differ from recipient)
SMTP_FROM=

# Receiver — inbox where contact form submissions are delivered
CONTACT_FORM_TO=shahidm@pytact.com

# Optional — HTML meta verification (Search Console / Bing Webmaster Tools)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
